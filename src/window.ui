<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="Adw" version="1.0"/>
  <template class="CameraWindow" parent="AdwApplicationWindow">
    <property name="title" translatable="yes">Camera</property>
    <property name="default-width">480</property>
    <property name="default-height">800</property>
    <property name="content">
      <object class="AdwToolbarView">
        <child type="top">
          <object class="AdwHeaderBar">
            <style>
              <class name="camera-header"/>
            </style>
            <child type="start">
              <object class="GtkBox">
                <property name="spacing">6</property>
                <child>
                  <object class="GtkMenuButton" id="camera_menu_button">
                    <property name="icon-name">view-grid-symbolic</property>
                    <property name="tooltip-text" translatable="yes">Choose Camera</property>
                    <property name="sensitive">False</property>
                  </object>
                </child>
                <child>
                  <object class="GtkMenuButton" id="flash_menu_button">
                    <property name="icon-name">camera-flash-symbolic</property>
                    <property name="tooltip-text" translatable="yes">Flash Mode</property>
                    <property name="sensitive">False</property>
                  </object>
                </child>
              </object>
            </child>
            <child type="end">
              <object class="GtkMenuButton">
                <property name="primary">True</property>
                <property name="icon-name">open-menu-symbolic</property>
                <property name="tooltip-text" translatable="yes">Main Menu</property>
                <property name="menu-model">primary_menu</property>
              </object>
            </child>
          </object>
        </child>
        <property name="content">
          <object class="GtkBox">
            <style>
              <class name="camera-background"/>
            </style>
            <property name="orientation">vertical</property>
            <property name="vexpand">True</property>
            <child>
              <object class="AdwToastOverlay" id="toast_overlay">
                <property name="vexpand">True</property>
                <property name="child">
                  <object class="GtkOverlay" id="preview_overlay">
                    <style>
                      <class name="camera-background"/>
                    </style>
                <property name="child">
                  <object class="GtkAspectFrame" id="preview_frame">
                    <property name="ratio">0.75</property>
                    <property name="obey-child">False</property>
                    <property name="xalign">0.5</property>
                    <property name="yalign">0.5</property>
                    <property name="hexpand">True</property>
                    <property name="vexpand">True</property>
                    <property name="child">
                      <object class="GtkOverlay">
                        <property name="hexpand">True</property>
                        <property name="vexpand">True</property>
                        <property name="child">
                          <object class="CameraView" id="camera_view">
                            <property name="hexpand">True</property>
                            <property name="vexpand">True</property>
                          </object>
                        </property>
                        <child type="overlay">
                          <object class="GtkDrawingArea" id="grid_overlay">
                            <property name="can-target">False</property>
                            <property name="hexpand">True</property>
                            <property name="vexpand">True</property>
                          </object>
                        </child>
                        <child type="overlay">
                          <object class="GtkDrawingArea" id="level_overlay">
                            <property name="can-target">False</property>
                            <property name="hexpand">True</property>
                            <property name="vexpand">True</property>
                          </object>
                        </child>
                      </object>
                    </property>
                  </object>
                </property>
                <child type="overlay">
                  <object class="GtkLabel" id="status_label">
                    <property name="label" translatable="yes">Starting camera…</property>
                    <property name="can-target">False</property>
                    <property name="halign">center</property>
                    <property name="valign">center</property>
                    <property name="justify">center</property>
                    <property name="wrap">True</property>
                    <property name="max-width-chars">40</property>
                    <property name="margin-start">24</property>
                    <property name="margin-end">24</property>
                    <style>
                      <class name="title-4"/>
                      <class name="osd"/>
                    </style>
                  </object>
                </child>
                <child type="overlay">
                  <object class="GtkLabel" id="recording_label">
                    <property name="visible">False</property>
                    <property name="can-target">False</property>
                    <property name="halign">center</property>
                    <property name="valign">start</property>
                    <property name="margin-top">12</property>
                    <style>
                      <class name="title-4"/>
                      <class name="osd"/>
                      <class name="error"/>
                    </style>
                  </object>
                </child>
                <child type="overlay">
                  <object class="GtkLabel" id="zoom_label">
                    <property name="visible">False</property>
                    <property name="can-target">False</property>
                    <property name="halign">end</property>
                    <property name="valign">start</property>
                    <property name="margin-top">12</property>
                    <property name="margin-end">16</property>
                    <style>
                      <class name="title-4"/>
                      <class name="osd"/>
                    </style>
                  </object>
                </child>
                <child type="overlay">
                  <object class="GtkBox" id="focus_reticle">
                    <property name="visible">False</property>
                    <property name="can-target">False</property>
                    <property name="halign">start</property>
                    <property name="valign">start</property>
                    <property name="width-request">64</property>
                    <property name="height-request">64</property>
                    <style>
                      <class name="focus-reticle"/>
                    </style>
                  </object>
                </child>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="GtkCenterBox">
                    <property name="halign">fill</property>
                    <property name="valign">end</property>
                    <property name="margin-start">24</property>
                    <property name="margin-end">24</property>
                    <property name="margin-top">12</property>
                    <property name="margin-bottom">28</property>
                    <child type="start">
                      <object class="GtkBox">
                        <property name="spacing">8</property>
                        <property name="height-request">56</property>
                        <property name="valign">center</property>
                        <child>
                          <object class="GtkBox">
                            <property name="width-request">56</property>
                            <property name="height-request">56</property>
                            <property name="valign">center</property>
                            <child>
                              <object class="GtkButton" id="last_photo_button">
                                <property name="visible">False</property>
                                <property name="action-name">win.open-last-media</property>
                                <property name="width-request">56</property>
                                <property name="height-request">56</property>
                                <property name="valign">center</property>
                                <property name="tooltip-text" translatable="yes">Open Last Photo or Video</property>
                                <style>
                                  <class name="flat"/>
                                </style>
                                <child>
                                  <object class="GtkStack" id="last_media_stack">
                                    <property name="width-request">48</property>
                                    <property name="height-request">48</property>
                                    <child>
                                      <object class="GtkPicture" id="last_photo_picture">
                                        <property name="content-fit">cover</property>
                                        <property name="can-shrink">True</property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkImage" id="last_video_icon">
                                        <property name="icon-name">camera-video-symbolic</property>
                                        <property name="pixel-size">28</property>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton" id="switch_button">
                            <property name="action-name">win.switch-camera</property>
                            <property name="width-request">56</property>
                            <property name="height-request">56</property>
                            <property name="valign">center</property>
                            <property name="tooltip-text" translatable="yes">Flip Camera</property>
                            <style>
                              <class name="flat"/>
                            </style>
                            <child>
                              <object class="GtkImage">
                                <property name="icon-name">camera-switch-symbolic</property>
                                <property name="pixel-size">28</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child type="center">
                      <object class="GtkButton" id="shutter_button">
                        <property name="action-name">win.capture</property>
                        <property name="width-request">72</property>
                        <property name="height-request">72</property>
                        <property name="tooltip-text" translatable="yes">Take Photo</property>
                        <style>
                          <class name="circular"/>
                          <class name="suggested-action"/>
                        </style>
                        <child>
                          <object class="GtkImage" id="shutter_image">
                            <property name="icon-name">camera-photo-symbolic</property>
                            <property name="pixel-size">32</property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child type="end">
                      <object class="GtkBox">
                        <property name="spacing">8</property>
                        <property name="height-request">56</property>
                        <property name="valign">center</property>
                        <child>
                          <object class="GtkButton" id="video_mode_button">
                            <property name="action-name">win.toggle-video-mode</property>
                            <property name="width-request">56</property>
                            <property name="height-request">56</property>
                            <property name="valign">center</property>
                            <property name="tooltip-text" translatable="yes">Switch to Video</property>
                            <style>
                              <class name="flat"/>
                            </style>
                            <child>
                              <object class="GtkImage" id="video_mode_image">
                                <property name="icon-name">camera-video-symbolic</property>
                                <property name="pixel-size">28</property>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="GtkBox">
                            <property name="width-request">56</property>
                            <property name="height-request">56</property>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
            </child>
          </object>
        </property>
      </object>
    </property>
  </template>
  <menu id="primary_menu">
    <section>
      <item>
        <attribute name="label" translatable="yes">_Settings</attribute>
        <attribute name="action">win.settings</attribute>
      </item>
    </section>
    <section>
      <item>
        <attribute name="label" translatable="yes">_About Camera</attribute>
        <attribute name="action">app.about</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">_Quit</attribute>
        <attribute name="action">app.quit</attribute>
      </item>
    </section>
  </menu>
</interface>
