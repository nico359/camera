<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="Adw" version="1.0"/>
  <template class="CameraWindow" parent="AdwApplicationWindow">
    <property name="title" translatable="yes">Camera</property>
    <property name="default-width">480</property>
    <property name="default-height">800</property>
    <property name="content">
      <object class="AdwToolbarView">
        <child type="top">
          <object class="AdwHeaderBar">
            <child type="start">
              <object class="GtkBox">
                <property name="spacing">6</property>
                <child>
                  <object class="GtkButton" id="switch_button">
                    <property name="action-name">win.switch-camera</property>
                    <property name="icon-name">camera-switch-symbolic</property>
                    <property name="tooltip-text" translatable="yes">Flip Camera</property>
                  </object>
                </child>
                <child>
                  <object class="GtkMenuButton" id="camera_menu_button">
                    <property name="icon-name">view-grid-symbolic</property>
                    <property name="tooltip-text" translatable="yes">Choose Camera</property>
                    <property name="sensitive">False</property>
                  </object>
                </child>
              </object>
            </child>
            <child type="end">
              <object class="GtkMenuButton">
                <property name="primary">True</property>
                <property name="icon-name">open-menu-symbolic</property>
                <property name="tooltip-text" translatable="yes">Main Menu</property>
                <property name="menu-model">primary_menu</property>
              </object>
            </child>
          </object>
        </child>
        <property name="content">
          <object class="AdwToastOverlay" id="toast_overlay">
            <property name="child">
              <object class="GtkOverlay">
                <property name="child">
                  <object class="GtkAspectFrame" id="preview_frame">
                    <property name="ratio">0.75</property>
                    <property name="obey-child">False</property>
                    <property name="xalign">0.5</property>
                    <property name="yalign">0.5</property>
                    <property name="hexpand">True</property>
                    <property name="vexpand">True</property>
                    <property name="child">
                      <object class="CameraView" id="camera_view">
                        <property name="hexpand">True</property>
                        <property name="vexpand">True</property>
                      </object>
                    </property>
                  </object>
                </property>
                <child type="overlay">
                  <object class="GtkLabel" id="status_label">
                    <property name="label" translatable="yes">Starting camera…</property>
                    <property name="halign">center</property>
                    <property name="valign">center</property>
                    <property name="justify">center</property>
                    <property name="wrap">True</property>
                    <property name="max-width-chars">40</property>
                    <property name="margin-start">24</property>
                    <property name="margin-end">24</property>
                    <style>
                      <class name="title-4"/>
                      <class name="osd"/>
                    </style>
                  </object>
                </child>
                <child type="overlay">
                  <object class="GtkCenterBox">
                    <property name="halign">fill</property>
                    <property name="valign">end</property>
                    <property name="margin-start">24</property>
                    <property name="margin-end">24</property>
                    <property name="margin-bottom">28</property>
                    <child type="start">
                      <object class="GtkBox">
                        <property name="width-request">56</property>
                        <property name="height-request">56</property>
                        <property name="valign">center</property>
                        <child>
                          <object class="GtkButton" id="last_photo_button">
                            <property name="visible">False</property>
                            <property name="action-name">win.open-last-photo</property>
                            <property name="width-request">56</property>
                            <property name="height-request">56</property>
                            <property name="valign">center</property>
                            <property name="tooltip-text" translatable="yes">Open Last Photo</property>
                            <style>
                              <class name="flat"/>
                            </style>
                            <child>
                              <object class="GtkPicture" id="last_photo_picture">
                                <property name="width-request">48</property>
                                <property name="height-request">48</property>
                                <property name="content-fit">cover</property>
                                <property name="can-shrink">True</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child type="center">
                      <object class="GtkButton" id="shutter_button">
                        <property name="action-name">win.capture</property>
                        <property name="width-request">72</property>
                        <property name="height-request">72</property>
                        <property name="tooltip-text" translatable="yes">Take Photo</property>
                        <style>
                          <class name="circular"/>
                          <class name="suggested-action"/>
                        </style>
                        <child>
                          <object class="GtkImage">
                            <property name="icon-name">camera-photo-symbolic</property>
                            <property name="pixel-size">32</property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child type="end">
                      <object class="GtkBox">
                        <property name="width-request">56</property>
                        <property name="height-request">56</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </property>
          </object>
        </property>
      </object>
    </property>
  </template>
  <menu id="primary_menu">
    <section>
      <item>
        <attribute name="label" translatable="yes">_Ask Which App to Open Photos</attribute>
        <attribute name="action">win.ask-open-with</attribute>
      </item>
    </section>
    <section>
      <item>
        <attribute name="label" translatable="yes">_About Camera</attribute>
        <attribute name="action">app.about</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">_Quit</attribute>
        <attribute name="action">app.quit</attribute>
      </item>
    </section>
  </menu>
</interface>
