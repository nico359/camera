<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.nico359.camera</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-2.0-or-later</project_license>

  <name>Camera</name>
  <summary>Take photos and videos on Linux phones</summary>
  <description>
    <p>Camera is a GTK4 and libadwaita camera application for FuriOS and other Halium-based Linux phones. It uses the FuriCam Camera2 engine for a real viewfinder, full-resolution photos and hardware-encoded video inside a Flatpak.</p>
    <p>Version 0.2.0 adds a settings dialog with per-camera photo resolutions and JPEG quality tiers, 1080p or experimental 4K H.264 video with optional stabilization, a 3×3 composition grid and a rotating level line driven by the phone’s accelerometer.</p>
    <p>Version 0.3.0 rounds out media handling: a full-window gallery with swipe navigation, pinch zoom and in-app video playback, cached video posters, and optional GPS tagging for photos that only uses fresh, accurate fixes.</p>
    <p>Version 0.4.0 adds a manual-exposure Pro panel, a keyboard-shortcuts sheet, a compact gallery pager, video scrubbing controls, reliable double-tap zoom and uninterrupted panning in the gallery viewer.</p>
    <p>Photos and videos are saved to the standard Pictures/Camera and Videos/Camera folders. The last-media thumbnail can instead open the latest item in the system viewer.</p>
  </description>

  <icon type="stock">io.github.nico359.camera</icon>

  <developer id="io.github.nico359">
    <name>nico359</name>
  </developer>

  <url type="homepage">https://github.com/nico359/camera</url>
  <url type="vcs-browser">https://github.com/nico359/camera</url>
  <url type="bugtracker">https://github.com/nico359/camera/issues</url>

  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>touch</control>
  </supports>

  <requires>
    <display_length compare="ge">360</display_length>
  </requires>

  <translation type="gettext">camera</translation>
  <launchable type="desktop-id">io.github.nico359.camera.desktop</launchable>

  <categories>
    <category>AudioVideo</category>
    <category>Video</category>
    <category>Recorder</category>
    <category>Photography</category>
  </categories>

  <keywords>
    <keyword>camera</keyword>
    <keyword>photo</keyword>
    <keyword>video</keyword>
    <keyword>capture</keyword>
    <keyword>flash</keyword>
    <keyword>focus</keyword>
  </keywords>

  <screenshots>
    <screenshot type="default">
      <caption>Photo mode</caption>
      <image>https://raw.githubusercontent.com/nico359/camera/v0.4.0/data/screenshot-photo.png</image>
    </screenshot>
    <screenshot>
      <caption>Video mode</caption>
      <image>https://raw.githubusercontent.com/nico359/camera/v0.4.0/data/screenshot-video.png</image>
    </screenshot>
  </screenshots>

  <branding>
    <color type="primary" scheme_preference="light">#62a0ea</color>
    <color type="primary" scheme_preference="dark">#1c71d8</color>
  </branding>

  <content_rating type="oars-1.1" />

  <releases>
    <release version="0.4.0" date="2026-11-08" type="stable">
      <description translate="no">
        <p>Camera and gallery polish release.</p>
        <ul>
          <li>Pro panel with ISO/shutter sliders, an Auto mode toggle, AE/AWB locks and an EV control beside tap-to-focus</li>
          <li>Cleaner hamburger menu with a keyboard-shortcuts sheet and a square, cropped last-media thumbnail that shows a real video frame</li>
          <li>Compact “N / total” gallery pager instead of an unbounded dot row</li>
          <li>Video player controls with play/pause, scrubbing and elapsed/total time</li>
          <li>Reliable double-tap zoom, including zooming back out while already zoomed</li>
          <li>Explicit gallery Back button and uninterrupted panning in the zoomed viewer</li>
        </ul>
      </description>
    </release>
    <release version="0.3.0" date="2026-11-06" type="stable">
      <description translate="no">
        <p>Media and location release.</p>
        <ul>
          <li>Full-window gallery with asynchronous photo decoding, prefetched neighbours and cached video posters</li>
          <li>Pinch zoom and drag-to-pan in the gallery, plus keyboard zoom</li>
          <li>Optional GPS tagging for photos with a 10 m accuracy gate and a live fix indicator</li>
          <li>Shutter blackout feedback instead of photo-saved toasts</li>
          <li>Fix a crash on repeated shutter presses</li>
        </ul>
      </description>
    </release>
    <release version="0.2.0" date="2026-11-01" type="stable">
      <description translate="no">
        <p>Settings and media browsing release.</p>
        <ul>
          <li>Settings dialog with per-camera photo resolutions, JPEG quality tiers, video resolution and video stabilization</li>
          <li>3×3 composition grid and a rotating level line driven by the phone’s accelerometer</li>
          <li>Full-window media gallery with horizontal swipe navigation and in-app video playback</li>
          <li>Optional external opening from the last-media thumbnail, with an app-chooser preference</li>
          <li>1080p H.264 recording with AAC audio; 4K remains experimental</li>
        </ul>
      </description>
    </release>
    <release version="0.1.0" date="2026-10-31" type="stable">
      <description translate="no">
        <p>First milestone release.</p>
        <ul>
          <li>Camera2 live preview with full-resolution JPEG capture</li>
          <li>1080p H.264 video recording with AAC audio</li>
          <li>Front, back and secondary camera switching, including the macro camera in the picker</li>
          <li>Pinch zoom, tap-to-focus and Off/On/Torch flash control</li>
          <li>Device-rotation-aware photos and a last-media thumbnail that opens through the system portal</li>
          <li>GNOME 51 Flatpak for FuriOS and other Halium phones</li>
        </ul>
      </description>
    </release>
  </releases>
</component>
