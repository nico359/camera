<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.nico359.camera</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <name>Camera</name>
  <summary>Take pictures with your camera</summary>
  <description>
    <p>Camera is a GTK4 and libadwaita camera application. On FuriOS and other Halium devices it uses the FuriCam Camera2 engine for full-resolution photos and hardware video encoding.</p>
    <p>This is an early development snapshot: live preview, photo capture and front/back switching are implemented.</p>
  </description>

  <developer id="io.github.nico359">
    <name>nico359</name>
  </developer>

  <url type="homepage">https://github.com/nico359/camera</url>
  <url type="vcs-browser">https://github.com/nico359/camera</url>
  <url type="bugtracker">https://github.com/nico359/camera/issues</url>

  <translation type="gettext">camera</translation>
  <launchable type="desktop-id">io.github.nico359.camera.desktop</launchable>
  <content_rating type="oars-1.1" />

  <releases>
    <release version="0.1.0" date="2026-10-30">
      <description>
        <p>Initial Camera2 preview, photo capture and camera switching.</p>
      </description>
    </release>
  </releases>
</component>
